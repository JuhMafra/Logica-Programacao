algoritmo "ex5"
//aluna Juliana Mafra
//Leia a nota de um candidato. Considere que a nota mínima é 70 pontos. Informe se ele foi aprovado ou reprovado.
var
  nota:real
inicio
   escreval("Digite a nota")
  leia(nota)
  se nota>=70 entao
  escreval ("Aprovado")
  senao
  escreval("Reprovado")
  fimse

fimalgoritmo
