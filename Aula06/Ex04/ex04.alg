algoritmo "ex04"
//aluna juliana
//Leia um número N digitado pelo usuário e imprima de 1 até N, de dois em dois.
var
i:inteiro
n:inteiro

inicio
	escreval("digite um numero")
  leia(n)
	para i de 1 ate n passo 2 faca //é pra contar de 1 ate N de 2 em 2
	escreval(i)// vai imprimir o contador na tela
  fimpara
fimalgoritmo