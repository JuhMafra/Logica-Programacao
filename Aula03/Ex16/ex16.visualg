algoritmo "ex16"

//ALuna Juliana Mafra

var
  voto: inteiro
  i: inteiro
  maria: inteiro
  joao: inteiro
  carlos: inteiro
inicio

  i<-1
  maria<-0
  joao<-0
  carlos<-0

  enquanto i<=20 faca
    escreval("---  Votação ---")
    escreval("--  1- Joao   --")
    escreval("--  2- Maria  --")
    escreval("--  3- Carlos --")
    escreval("----------------")
    escreval("Digita o voto ",i)
    leia(voto)

    se voto = 1 entao
      joao<-joao+1
      i<-i+1
    senao
      se voto = 2 entao
        maria<-maria+1
        i<-i+1
      senao
        se voto = 3 entao
          carlos<-carlos+1
          i<-i+1
        senao
          escreval("Voto invalido, aperte enter para votar novamente")
          leia(voto)
        fimse
      fimse
    fimse

    limpatela
  fimenquanto

  escreval("Maria recebeu ",maria," votos")
  escreval("Joao recebeu ",joao," votos")
  escreval("Carlos recebeu ",carlos," votos")
  escreval()

  se maria > joao e maria > carlos entao
    escreval("Maria venceu!")
  senao
    se joao > maria e joao > carlos entao
      escreval("Joao venceu!")
    senao
      se carlos > maria e carlos > joao entao
        escreval("Carlos venceu!")
      senao
        escreval("Houve empate!")
      fimse
    fimse
  fimse

fimalgoritmo
