Algoritmo "ex06"

//aluna Juliana Mafra

var
  d: real
 l: real
 consumo: real
Inicio
  
    escreval("Quanto voce percorreu em KM")
    leia(d)
    escreval("Quantos libtro de combustivel foi consumido em litros")
    leia(l)
    consumo<-d/l
    escreval("O consumo de combustivel foi de ",consumo:8:2," KM/L")
fimalgoritmo